{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 桌面端：原生窗口运行 dsh web，内置更新检查与一键自动更新",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
